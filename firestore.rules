rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // v3-* collections (clean rebuild)
    function isAuth() { return request.auth != null; }

    match /v3-products/{doc}       { allow read, write: if isAuth(); }
    match /v3-stock-moves/{doc}    { allow read, write: if isAuth(); }
    match /v3-transactions/{doc}   { allow read, write: if isAuth(); }
    match /v3-users/{doc}          { allow read, write: if isAuth(); }
    match /v3-suppliers/{doc}      { allow read, write: if isAuth(); }
    match /v3-purchase-orders/{doc}{ allow read, write: if isAuth(); }
    match /v3-supplier-payments/{doc}{ allow read, write: if isAuth(); }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}